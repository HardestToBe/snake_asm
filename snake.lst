     1                                  bits 16
     2                                  org 0x8000
     3                                  
     4                                  ; 常量放最前面
     5                                  ; 移动方向
     6                                  DIR_UP    equ 0
     7                                  DIR_RIGHT equ 1
     8                                  DIR_DOWN  equ 2
     9                                  DIR_LEFT  equ 3
    10                                  
    11                                  SNAKE_MAX_LENGTH equ 2000
