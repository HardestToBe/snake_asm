    51                                  game_init:
    52                                  	; 清个屏先
    53 00000026 B80300                  	mov ax, 0x0003
    54 00000029 CD10                    	int 0x10
    55                                  	;初始时间
    56 0000002B B400                    	mov ah, 0
    57 0000002D CD1A                    	int 0x1a
    58 0000002F 8916[DE01]              	mov [last_tick], dx
    59                                  	; 初始化蛇的位置
    60 00000033 31F6                    	xor si, si
    61 00000035 51                      	push cx
    62 00000036 8A0E[8711]              	mov cl, [init_snake_x]
    63 0000003A 8A2E[8811]              	mov ch, [init_snake_y]
    64                                  .init_body:
    65 0000003E 3B36[E301]              	cmp si, [snake_length]
    66 00000042 7311                    	jae .print_snake_head
    67 00000044 88CA                    	mov dl, cl
    68 00000046 8894[E501]              	mov byte [snake_x + si], dl
    69 0000004A 88EE                    	mov dh, ch
    70 0000004C 88B4[B509]              	mov byte [snake_y + si], dh
    71 00000050 46                      	inc si
    72 00000051 FEC9                    	dec cl		; 水平排列只要减少x
    73 00000053 EBE9                    	jmp .init_body
    74                                  	
    75                                  	
    76                                  .print_snake_head:
    77 00000055 59                      	pop cx
    78                                  	; 蛇头
    79                                  	; int10,ah=02为设置光标位置
    80                                  	; BH = 显示页号,一般使用 0
    81                                  	; DH = 行号 y,0 ~ 24
    82                                  	; DL = 列号 x,0 ~ 79
    83 00000056 B402                    	mov ah, 0x02
    84 00000058 B700                    	mov bh, 0
    85                                  
    86 0000005A 8A36[B509]              	mov dh, [snake_y]
    87 0000005E 8A16[E501]              	mov dl, [snake_x]
    88                                  
    89 00000062 CD10                    	int 0x10
    90                                  	
    91                                  	; int10,ah=09为在光标位置输出字符
    92                                  	; AL = 要输出的字符
    93                                  	; BH = 显示页,通常 0
    94                                  	; BL = 字符颜色属性
    95                                  	; 常用颜色：00h  黑色，01h  蓝色，02h  绿色，04h  红色，07h  灰白色，0Ah  亮绿色，		
    96                                  	; 0Ch; 亮红色，0Eh  黄色，0Fh  亮白色
    97                                  	; CX = 输出多少次
    98 00000064 B409                    	mov ah, 0x09
    99 00000066 B04F                    	mov al, 'O'
   100 00000068 B700                    	mov bh, 0
   101 0000006A B30A                    	mov bl, 0x0A
   102 0000006C B90100                  	mov cx, 1
   103 0000006F CD10                    	int 0x10
   104                                  
   105 00000071 BE0100                  	mov si, 1
