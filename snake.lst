   111 00000078 731E                    	jae  game_loop
   112                                  
   113 0000007A B402                    	mov ah, 0x02
   114 0000007C B700                    	mov bh, 0
   115 0000007E 8AB4[B509]              	mov dh, [snake_y + si]
   116 00000082 8A94[E501]              	mov dl, [snake_x + si]
   117                                  
   118 00000086 CD10                    	int 0x10
   119                                  
