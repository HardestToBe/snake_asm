   130                                  game_loop:
   131                                  	
   132 00000098 E81900                  	call check_keyboard
   133                                  	; 获取bios tick
   134 0000009B B400                    	mov ah, 0
   135 0000009D CD1A                    	int 0x1a
   136                                  
   137 0000009F 89D0                    	mov ax, dx
   138 000000A1 2B06[DE01]              	sub ax, [last_tick]
   139                                  
   140 000000A5 3B06[E001]              	cmp ax, [tick_interval]
   141 000000A9 72ED                    	jb game_loop; 无符号小于
   142                                  
   143 000000AB 8916[DE01]              	mov [last_tick], dx
   144                                  
   145 000000AF E8A500                  	call move_snake
   146 000000B2 EBE4                    	jmp game_loop
