   149                                  check_keyboard:
   150                                  	; 有没有按键？
   151 000000B4 B401                        mov ah, 0x01
   152 000000B6 CD16                        int 0x16
   153 000000B8 7450                    	jz .done	;没有按键就返回
   154                                  
   155                                  	;读到按键就记录,AL = ASCII 码,AH = 键盘扫描码
   156 000000BA B400                        mov ah, 0x00
   157 000000BC CD16                    	int 0x16
   158                                  
   159                                      ; 检测之后，ah为扫描码，al为ascii码
   160                                      
   161 000000BE 80FC48                      cmp ah, 0x48       ; ↑
   162 000000C1 7411                        je .up
   163                                  
   164 000000C3 80FC50                      cmp ah, 0x50       ; ↓
   165 000000C6 741A                        je .down
   166                                  
   167 000000C8 80FC4B                      cmp ah, 0x4B       ; ←
   168 000000CB 7423                        je .left
   169                                  
   170 000000CD 80FC4D                      cmp ah, 0x4D       ; →
   171 000000D0 742C                        je .right
   172                                  
   173 000000D2 EB36                        jmp .done
   174                                      
   175                                  ; .up里面的.是一个局部标签，归属于离他最近的非局部标签，比如这里的.up全称就是check_keyboard.up
   176                                  .up:
   177 000000D4 803E[E201]02            	cmp byte [direction], DIR_DOWN
   178 000000D9 742F                    	je .done
   179 000000DB C606[E201]00            	mov byte [direction], DIR_UP
   180 000000E0 EB28                    	jmp .done
   181                                  .down:
   182 000000E2 803E[E201]00            	cmp byte [direction], DIR_UP
   183 000000E7 7421                    	je .done
   184 000000E9 C606[E201]02                mov byte [direction], DIR_DOWN
   185 000000EE EB1A                        jmp .done
   186                                  .left:
   187 000000F0 803E[E201]01            	cmp byte [direction], DIR_RIGHT
   188 000000F5 7413                    	je .done
   189 000000F7 C606[E201]03                mov byte [direction], DIR_LEFT
   190 000000FC EB0C                        jmp .done
   191                                  .right:
   192 000000FE 803E[E201]03            	cmp byte [direction], DIR_LEFT
   193 00000103 7405                    	je .done
   194 00000105 C606[E201]01                mov byte [direction], DIR_RIGHT
   195                                  
   196                                  .done:
   197 0000010A C3                          ret
   198                                  
   199                                  ; 检测蛇头
   200                                  check_next_head:
   201                                  	;先检测当前移动方向，如果操作数是内存则需要明确大小，不过另一边是寄存器的话就不用明确
   202 0000010B 8A16[E501]              	mov dl, [snake_x]
   203 0000010F 8A36[B509]              	mov dh, [snake_y]
   204                                  
   205 00000113 803E[E201]00            	cmp byte [direction], DIR_UP
   206 00000118 7417                    	je .up
   207                                  
   208 0000011A 803E[E201]02            	cmp byte [direction], DIR_DOWN
   209 0000011F 7419                    	je .down
   210                                  
   211 00000121 803E[E201]03            	cmp byte [direction], DIR_LEFT
   212 00000126 741B                    	je .left
   213                                  
   214 00000128 803E[E201]01            	cmp byte [direction], DIR_RIGHT
   215 0000012D 741D                    	je .right
   216                                  	;防止落入.up可以加一个明确的分支
   217 0000012F EB24                    	jmp .blocked
   218                                  
   219                                  .up:
   220 00000131 80FE00                  	cmp dh, 0
   221 00000134 741F                        je .blocked
   222 00000136 FECE                    	dec dh
   223 00000138 EB19                    	jmp .allowed
   224                                  
   225                                  .down:
   226 0000013A 80FE18                  	cmp dh, 24
   227 0000013D 7316                        jae .blocked
   228 0000013F FEC6                    	inc dh
   229 00000141 EB10                    	jmp .allowed
   230                                  
   231                                  .left:
   232 00000143 80FA00                  	cmp dl, 0
   233 00000146 740D                        je .blocked
   234 00000148 FECA                    	dec dl
   235 0000014A EB07                    	jmp .allowed
   236                                  
   237                                  .right:
   238 0000014C 80FA4F                  	cmp dl, 79
   239 0000014F 7304                        jae .blocked
   240 00000151 FEC2                    	inc dl
   241                                  
   242                                  .allowed:
   243 00000153 F8                      	clc		; 清除进位标志，CF = 0，允许移动
   244 00000154 C3                      	ret
   245                                  
   246                                  .blocked:
   247 00000155 F9                      	stc
   248 00000156 C3                      	ret
   249                                  
